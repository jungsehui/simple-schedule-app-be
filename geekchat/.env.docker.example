# GeekChat v2 — Docker Compose env template
# Copy this to .env.docker and fill in. NEVER commit .env.docker.

# ── Database ──
DB_NAME=geekchat
DB_USERNAME=geekchat
DB_PASSWORD=changeme-strong-pw
DB_ROOT_PASSWORD=changeme-root-pw

# ── Spring Boot ──
# Empty = production profile (Hibernate validate).
# For first deploy, set to "" but use SPRING_JPA_HIBERNATE_DDL_AUTO=update to bootstrap.
SPRING_PROFILES_ACTIVE=
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# ── JWT ──
# Min 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-character-secret-please

# ── Frontend / CORS ──
# Production frontend (Vercel) URL
FRONTEND_URL=https://geek-chat-web-v2.vercel.app
# Additional origin patterns (CSV) for Vercel preview deploys
FRONTEND_ORIGIN_PATTERNS=https://*.vercel.app

# ── OAuth ──
# Set this to https://api.<your-domain>/auth/callback
OAUTH_CALLBACK_URL=https://api.geek-chat.example/auth/callback

# Google Cloud Console → OAuth 2.0 Client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Naver Developers → Application
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
