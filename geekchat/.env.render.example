# Env template for the Render (Docker) + Supabase (Postgres) free deployment.
# render.yaml declares these; set the `sync: false` ones in the Render dashboard (never commit real
# secrets). Copy to your notes, fill in, then paste into Render. See docs/DEPLOY-RENDER.md.

# ── Supabase Postgres ── (Supabase → Connect → "Session pooler")
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com   # your pooler host
DB_PORT=5432                                        # session pooler = 5432 (transaction pooler = 6543)
DB_NAME=postgres
DB_USERNAME=postgres.xxxxxxxxxxxxxxxxxxxx           # postgres.<project-ref>
DB_PASSWORD=your-supabase-db-password
DB_SSLMODE=require
# First deploy only — creates the schema on the empty DB (app default is `validate`):
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ── Auth ──
JWT_SECRET=generate-a-random-string-at-least-32-bytes-long   # Render can auto-generate this
FRONTEND_URL=https://your-frontend.vercel.app
OAUTH_CALLBACK_URL=https://your-service.onrender.com/auth/callback

# ── OAuth (optional) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── AI chat (optional — app boots and human chat works without a key) ──
AI_CHAT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=

# ── JVM (512MB free instance) ──
JAVA_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=65.0 -XX:MaxMetaspaceSize=160m -Dspring.jmx.enabled=false
